# Copy this file to .env.local and fill the values. Never commit .env.local.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SECRET. Server only. Never put NEXT_PUBLIC_ in front of it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend: resend.com > API Keys
RESEND_API_KEY=re_xxxxxxxxx
# While testing use onboarding@resend.dev (it only sends to the email you signed up to Resend with).
# For real users, verify your own domain in Resend and use e.g. reminders@yourdomain.com
RESEND_FROM=Dawaa Reminder <onboarding@resend.dev>

# Any long random text you make up. The cron service must send it.
CRON_SECRET=change-me-to-a-long-random-string

# Your site URL (used in the email link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
